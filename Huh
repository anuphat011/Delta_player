-- Helper Functions
local function Teleport(cframe)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char:PivotTo(cframe)
    end
end

local function EquipWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end
    
    -- Unequip non-matching tools in character
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local toolType = tool:GetAttribute("Type")
            if toolType ~= _G.MainWeapon and not (_G.Select_EquipWeapon and table.find(_G.Select_EquipWeapon, toolType)) then
                tool.Parent = backpack
            end
        end
    end
    
    -- Equip main weapon
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("Type") == _G.MainWeapon then
            local hum = char:FindFirstChild("Humanoid")
            if hum then hum:EquipTool(tool) end
            break
        end
    end
    
    -- Equip support weapons
    if _G.Select_EquipWeapon and type(_G.Select_EquipWeapon) == "table" then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and table.find(_G.Select_EquipWeapon, tool:GetAttribute("Type")) then
                tool.Parent = char
            end
        end
    end
end

local function UseSkills()
    local char = LocalPlayer.Character
    if not char then return end
    
    local skills = {}
    if _G.AutoSkillZ then table.insert(skills, "z") end
    if _G.AutoSkillX then table.insert(skills, "x") end
    if _G.AutoSkillC then table.insert(skills, "c") end
    if _G.AutoSkillV then table.insert(skills, "v") end
    if _G.AutoSkillF then table.insert(skills, "f") end
    
    if #skills == 0 then return end
    
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local randomSkill = skills[math.random(1, #skills)]
            ActionRemote:FireServer(tool.Name, randomSkill)
        end
    end
end

local function AttackHit()
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            ActionRemote:FireServer(tool.Name, "hit")
        end
    end
end

local function GetQuestFrame()
    local hud = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("HUD")
    if hud and hud:FindFirstChild("Main") and hud.Main:FindFirstChild("Frame_Quest") then
        return hud.Main.Frame_Quest
    end
    return nil
end

local function GetBestQuest(playerLevel)
    local best = ProcessedQuests[1]
    for _, q in ipairs(ProcessedQuests) do
        if playerLevel >= q.Level then
            best = q
        else
            break
        end
    end
    return best
end

local lastInvTick = 0
local cachedInventory = {}
local function GetInventory()
    if tick() - lastInvTick < 0.2 then
        return cachedInventory
    end
    lastInvTick = tick()
    
    local invAttr = LocalPlayer:GetAttribute("Inventory")
    if invAttr then
        local success, result = pcall(function()
            return HttpService:JSONDecode(invAttr)
        end)
        if success and type(result) == "table" then
            cachedInventory = result
            return cachedInventory
        end
    end
    cachedInventory = {}
    return cachedInventory
end

local function GetItemAmount(itemName)
    local inv = GetInventory()
    if inv and inv[itemName] and inv[itemName].amount then
        return tonumber(inv[itemName].amount) or 0
    end
    return 0
end

local vfxConn = nil
local function ToggleVFX(disable)
    if disable then
        VFX:ClearAllChildren()
        if not vfxConn then
            vfxConn = VFX.DescendantAdded:Connect(function(desc)
                pcall(function() desc:Destroy() end)
            end)
        end
    else
        if vfxConn then
            vfxConn:Disconnect()
            vfxConn = nil
        end
    end
end

